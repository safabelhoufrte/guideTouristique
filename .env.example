POSTGRES_DB=guide_touristique
# Host programs use localhost:15432; containers use db:5432.
DB_HOST_PORT=15432
# Replace these local placeholders with different passwords before starting.
POSTGRES_PASSWORD=replace-admin-password
GUIDE_DB_PASSWORD=replace-guide-password
CIRCUIT_DB_PASSWORD=replace-circuit-password
RESERVATION_DB_PASSWORD=replace-reservation-password
AVIS_DB_PASSWORD=replace-avis-password
# The real Guide service will be added to the shared Compose network.
GUIDE_SERVICE_URL=http://guide-service:8001
