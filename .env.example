# Admin credentials are used only by PostgreSQL initialization, never by applications.
DB_USER=postgres
DB_PASSWORD=replace-admin-password
# Change this host port if needed; containers always connect to postgres:5432.
DB_HOST_PORT=15433
# Circuit remains 8082 inside Docker; change the host port only if occupied.
CIRCUIT_HOST_PORT=8082
GUIDE_DB_PASSWORD=replace-guide-password
CIRCUIT_DB_PASSWORD=replace-circuit-password
RESERVATION_DB_PASSWORD=replace-reservation-password
AVIS_DB_PASSWORD=replace-avis-password
# Local Keycloak only. Generate values with python scripts/setup-local-auth.py.
KEYCLOAK_DB_PASSWORD=replace-keycloak-db-password
KEYCLOAK_ADMIN_PASSWORD=replace-keycloak-admin-password
KEYCLOAK_DEMO_PASSWORD=replace-local-demo-password
RESERVATION_HOST_PORT=8083
