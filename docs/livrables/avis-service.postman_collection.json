  "item": [
    {
      "name": "0.1 Obtenir token demo-touriste",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"0.1 Obtenir token demo-touriste -> 200\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.access_token).to.be.a(\"string\");",
              "    pm.collectionVariables.set(\"tokenTouriste\", data.access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}",
              "type": "text"
            },
            {
              "key": "username",
              "value": "{{usernameTouriste}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{passwordTouriste}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{keycloakUrl}}/realms/guide-touristique/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "realms",
            "guide-touristique",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      }
    },
