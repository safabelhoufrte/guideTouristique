                  "pm.test('Réponse en moins de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test('Bon identifiant', () =>",
                  "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('circuitId'))));"
                ]
