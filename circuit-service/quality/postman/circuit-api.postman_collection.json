{
  "info": {
    "name": "Guide Touristique - API Circuit",
    "description": "Tests fonctionnels de l'API Circuit : lecture publique, sécurité Keycloak, écritures ADMIN et règles GUIDE. Les jetons viennent de l'environnement (jamais enregistrés dans le dépôt). Les circuits créés sont archivés à la fin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Lecture publique",
      "item": [
        {
          "name": "Lister les circuits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/circuits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "circuits"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Réponse en moins de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "const list = pm.response.json();",
                  "pm.test('Tableau non vide', () => pm.expect(list).to.be.an('array').that.is.not.empty);",
                  "pm.test('Champs du contrat', () => list.forEach(c => pm.expect(c).to.include.all.keys(",
                  "  'id', 'titre', 'description', 'ville', 'dureeHeures', 'prix', 'guideId')));",
                  "pm.test('Photo servie par lien, pas incluse', () =>",
                  "  pm.expect(pm.response.text()).to.not.include('data:image'));",
                  "pm.collectionVariables.set('circuitId', list[0].id);",
                  "const withPhoto = list.find(c => c.image);",
                  "if (withPhoto) pm.collectionVariables.set('photoCircuitId', withPhoto.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrer par ville",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/circuits?ville=Agadir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "circuits"
              ],
              "query": [
                {
                  "key": "ville",
                  "value": "Agadir"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Seulement Agadir', () => pm.response.json().forEach(c =>",
                  "  pm.expect(c.ville.toLowerCase()).to.eql('agadir')));"
                ]
              }
            }
          ]
        },
        {
