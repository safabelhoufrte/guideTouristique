            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 404', () => pm.response.to.have.status(404));",
                  "pm.test('Erreur au format ApiError', () => {",
                  "  const e = pm.response.json();",
                  "  pm.expect(e.status).to.eql(404);",
                  "  pm.expect(e).to.have.keys('timestamp', 'status', 'error', 'message', 'path');",
                  "  pm.expect(e.message).to.eql(\"Circuit introuvable\");",
                  "});"
                ]
