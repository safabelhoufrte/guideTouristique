            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Type image', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//));",
                  "pm.test('ETag SHA-256', () => pm.expect(pm.response.headers.get('ETag')).to.match(/^\"[0-9a-f]{64}\"$/));",
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Photo inchangée (cache)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{etag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/circuits/{{photoCircuitId}}/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "circuits",
                "{{photoCircuitId}}",
                "image"
