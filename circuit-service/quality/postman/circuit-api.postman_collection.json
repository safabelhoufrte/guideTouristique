        {
          "name": "Photo d'un circuit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/circuits/{{photoCircuitId}}/image",
              "host": [
                "{{baseUrl}}"
